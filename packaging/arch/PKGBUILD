pkgname=linernotes-git
pkgver=0.1.0.r274.g9da1055
pkgrel=1
pkgdesc="Modern local music player with AI-powered features"
arch=('x86_64')
url="https://github.com/liugantang/Linernotes"
license=('GPL-3.0-or-later')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qtkeychain-qt6'
  'mpv'
  'taglib'
  'uchardet'
  'icu'
  'chromaprint'
  'ffmpeg'
  'libebur128'
  'sqlite'
  'json-schema-validator'
  'onnxruntime'
)
makedepends=(
  'git'
  'cmake'
  'ninja'
  'qt6-tools'
  'nlohmann-json'
)
provides=('linernotes')
conflicts=('linernotes')
_model=msclap-2023-audio.onnx
source=("linernotes::git+file://$(realpath "$startdir/../..")#branch=main"
        "$_model::$url/releases/download/model-msclap-2023/$_model")
sha256sums=('SKIP'
            '33cd10e02990c0fb8ffda1656ac339db723f34fc85ea4ae21c1950aed701d035')

pkgver() {
  cd "$srcdir/linernotes"
  # 仓库的 tag 是阶段标记（phase-NN），版本号取 CMake project(VERSION)
  local ver
  ver=$(sed -n 's/^ *VERSION \([0-9.]*\)$/\1/p' CMakeLists.txt | head -n1)
  printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -B build -S linernotes \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/linernotes \
    -DCMAKE_INSTALL_BINDIR=. \
    -DCMAKE_INSTALL_DATADIR=/usr/share \
    -DLINERNOTES_BUILD_TESTS=OFF \
    -DLINERNOTES_BUILD_TOOLS=OFF \
    -DLINERNOTES_AUDIO_MODEL="$srcdir/$_model"
  cmake --build build
}

package() {
  # 程序与资源（models/）一起放在 /opt/linernotes；桌面文件、图标、许可证仍装到 /usr/share
  DESTDIR="$pkgdir" cmake --install build
  install -d "$pkgdir/usr/bin"
  ln -s /opt/linernotes/linernotes "$pkgdir/usr/bin/linernotes"
}
