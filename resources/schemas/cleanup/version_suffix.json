{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VersionSuffix",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "role": {
            "type": "string",
            "enum": ["version", "annotation", "title_part"]
          },
          "type": {
            "type": ["string", "null"],
            "enum": [
              null,
              "live",
              "remaster",
              "acoustic",
              "remix",
              "demo",
              "instrumental",
              "edit",
              "alternate"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["id", "role", "confidence", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
