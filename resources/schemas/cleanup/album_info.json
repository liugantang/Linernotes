{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlbumInfo",
  "type": "object",
  "properties": {
    "albums": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "year": {
            "$ref": "#/definitions/integerField"
          },
          "albumArtist": {
            "$ref": "#/definitions/stringField"
          },
          "discTotal": {
            "$ref": "#/definitions/integerField"
          },
          "discs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "disc": {
                  "type": "integer"
                },
                "trackTotal": {
                  "$ref": "#/definitions/integerField"
                }
              },
              "required": ["disc"],
              "additionalProperties": false
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "title": {
                  "$ref": "#/definitions/stringField"
                },
                "artist": {
                  "$ref": "#/definitions/stringField"
                },
                "trackNumber": {
                  "$ref": "#/definitions/integerField"
                },
                "discNumber": {
                  "$ref": "#/definitions/integerField"
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["albums"],
  "additionalProperties": false,
  "definitions": {
    "stringField": {
      "type": ["object", "null"],
      "properties": {
        "value": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": "string",
          "enum": ["path", "tags", "knowledge"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["value", "evidence", "confidence"],
      "additionalProperties": false
    },
    "integerField": {
      "type": ["object", "null"],
      "properties": {
        "value": {
          "type": ["integer", "null"]
        },
        "evidence": {
          "type": "string",
          "enum": ["path", "tags", "knowledge"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["value", "evidence", "confidence"],
      "additionalProperties": false
    }
  }
}
