{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtistMerge",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "subsets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "members": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": ["members", "confidence", "reason"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "subsets"],
        "additionalProperties": false
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false
}
