---
BasedOnStyle: WebKit
IndentWidth: 4
ColumnLimit: 100
UseTab: Never
PointerAlignment: Right

IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeCategories:
  - Regex: '^<linernotes/'
    Priority: 1
  - Regex: '^"'
    Priority: 1
  - Regex: '^<Q'
    Priority: 2
  - Regex: '^<.*[/\\.]'
    Priority: 3
  - Regex: '^<'
    Priority: 4

AllowShortFunctionsOnASingleLine: Inline
BreakConstructorInitializers: BeforeComma
NamespaceIndentation: None
FixNamespaceComments: true
Standard: c++20
...
